<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaced the legacy launch window with the SplashScreen
         API, which ignores windowBackground and uses these attributes instead.
         Without this the platform falls back to the launcher icon on a default
         background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/petmate_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/petmate_splash</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/petmate_paper</item>
    </style>
</resources>
