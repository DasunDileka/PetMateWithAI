<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon.

    Android renders the small icon as a monochrome silhouette: every non-
    transparent pixel is flattened to a single tint colour. Passing the
    full-colour launcher icon therefore produces a featureless filled square.
    This is a dedicated white-on-transparent paw mark so the notification is
    recognisably PetMate at 24dp.
-->
